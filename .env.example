NEXT_PUBLIC_APP_URL=https://taskara.vercel.app
NEXT_PUBLIC_APP_NAME=Taskara

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Connection String
DATABASE_URL=postgresql://postgres:password@db.your-supabase-project.supabase.co:5432/postgres

# Payment Provider Config (Midtrans / Xendit)
PAYMENT_PROVIDER=midtrans
PAYMENT_SERVER_KEY=your-payment-server-key
PAYMENT_CLIENT_KEY=your-payment-client-key
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret

# Email Service
RESEND_API_KEY=re_123456789
EMAIL_FROM=Taskara <notifications@taskara.id>

# Rate Limit & Storage
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token
STORAGE_BUCKET_PUBLIC=public-assets
STORAGE_BUCKET_PRIVATE=project-files
